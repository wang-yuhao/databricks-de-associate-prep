# Copy this file to .env and fill in your real values. Never commit the real .env file.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alpaca_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Only needed if you want ingestion scripts to pull fresh data from Alpaca directly
# instead of reading what's already in Postgres.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
